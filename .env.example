# Water Monitor - Firebase & Service Configuration
# If these variables are not provided, the application runs in Demo Mode with mock data.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_DATABASE_URL=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Ntfy Notification Server (default https://ntfy.sh)
VITE_NTFY_BASE_URL=https://ntfy.sh
